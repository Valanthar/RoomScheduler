{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",

  // Connection string — overridden in production by the environment variable:
  //   ConnectionStrings__DefaultConnection=<your-value>
  "ConnectionStrings": {
    "DefaultConnection": "Data Source=roomscheduler.db"
  },

  // JWT config — Jwt__Secret MUST be supplied via environment variable in production.
  // No placeholder is stored here so it can never be accidentally committed to source control.
  "Jwt": {
    "Issuer": "RoomScheduler",
    "Audience": "RoomScheduler",
    "ExpirationMinutes": "60"
  },

  "Cors": {
    "AllowedOrigins": [ "http://localhost:3000" ]
  }
}
